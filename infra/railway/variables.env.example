# Railway service variables for the `api` service.
# Copy into Railway (Variables -> RAW editor) per environment and replace the values.
# This file is documentation only: it must never contain real secrets.

# --- Required ------------------------------------------------------------
# These five are the only variables the API refuses to boot without.
ENV=production                      # production | staging | development
NODE_ENV=production
DATABASE_URL=${{postgres.DATABASE_URL}}
HASH_PEPPER=<random 32+ chars>      # generate per environment, never reuse
JWT_SECRET_KEY=<random 32+ chars>   # generate per environment, never reuse
# PORT is injected by Railway.

# --- Recommended wiring (Railway variable references, keep as-is) --------
REDIS_URL=${{redis.REDIS_URL}}
APP_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
FRONTEND_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=https://${{web.RAILWAY_PUBLIC_DOMAIN}}

# --- Feature flags ------------------------------------------------------
ENABLE_ACTIVITY_IMPORT=true
ENABLE_ACTIVITY_PROCESSING=true

# --- Optional integrations ----------------------------------------------
# Everything below is optional. Leave a variable out entirely (or blank) and
# the feature it powers simply stays unavailable: the API still boots, and the
# affected endpoint reports a clear error when it is actually called.
#
# Do NOT invent placeholder values such as `unconfigured` — a placeholder makes
# the app believe the integration exists and turns a clean "not configured"
# response into a confusing authentication failure from the third party.
#
# Strava (activity import + webhooks)
#   STRAVA_CLIENT_ID
#   STRAVA_CLIENT_SECRET
#   STRAVA_REDIRECT_URI=https://${{RAILWAY_PUBLIC_DOMAIN}}/auth/strava/callback
#   STRAVA_WEBHOOK_TOKEN
#
# Polar (activity import + webhooks)
#   POLAR_CLIENT_ID
#   POLAR_CLIENT_SECRET
#   POLAR_REDIRECT_URI=https://${{RAILWAY_PUBLIC_DOMAIN}}/auth/polar/callback
#   POLAR_WEBHOOK_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/webhooks/polar
#   POLAR_WEBHOOK_SECRET_KEY
#
# Garmin / Suunto (activity import + workout export)
#   GARMIN_CLIENT_ID GARMIN_CLIENT_SECRET GARMIN_REDIRECT_URI
#   SUUNTO_CLIENT_ID SUUNTO_CLIENT_SECRET SUUNTO_REDIRECT_URI
#   SUUNTO_SUBSCRIPTION_KEY
#
# Intervals.icu (activity import). Authenticates with a static personal API key
# from https://intervals.icu/settings — there is no OAuth app to register.
# Setting these lets a single-user deployment connect without the key ever
# passing through the settings UI: they are used only when the connect request
# supplies no key of its own, and are validated against the Intervals.icu
# athlete endpoint at connect time. Leave them out and the UI dialog still
# works. The athlete ID is optional even with a key set — it is resolved from
# the API — and looks like `i123456`, with the leading `i`.
#   INTERVALS_ICU_API_KEY
#   INTERVALS_ICU_ATHLETE_ID
#
# Transactional email (Brevo). Without BREVO_API_KEY the app logs a warning
# and skips every outgoing email — signup, invitations and password reset
# links will not be delivered.
#   BREVO_API_KEY
#   BREVO_FROM_EMAIL
#
# Push notifications / auth (Firebase), error tracking (Better Stack)
#   FIREBASE_FUNCTIONS_URL FIREBASE_SERVICE_ACCOUNT_JSON
#   BETTER_STACK_DSN

# --- web service --------------------------------------------------------
# PORT=80
# VITE_API_BASE_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
# VITE_BETTER_STACK_DSN=              # browser error reporting; unset = disabled.
#                                     # Build-time only, and must be a DSN you own.
