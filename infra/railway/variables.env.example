# Railway service variables for the `api` service.
# Copy into Railway (Variables -> RAW editor) per environment and replace the values.
# This file is documentation only: it must never contain real secrets.

# --- Core ---------------------------------------------------------------
ENV=production                      # production | staging | development
NODE_ENV=production
# PORT is injected by Railway.

# --- Wiring (Railway variable references, keep as-is) -------------------
DATABASE_URL=${{postgres.DATABASE_URL}}
REDIS_URL=${{redis.REDIS_URL}}
APP_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
FRONTEND_URL=https://${{web.RAILWAY_PUBLIC_DOMAIN}}
CORS_ORIGINS=https://${{web.RAILWAY_PUBLIC_DOMAIN}}

# --- Secrets (generate per environment, never reuse across environments) -
HASH_PEPPER=<random 32+ chars>
JWT_SECRET_KEY=<random 32+ chars>

# --- Required by the env schema, inert placeholders when the integration --
# --- is not configured. The app boots and every non-integration feature ---
# --- works; these providers simply stay unavailable. ---------------------
STRAVA_CLIENT_ID=unconfigured
STRAVA_CLIENT_SECRET=unconfigured
STRAVA_REDIRECT_URI=https://${{RAILWAY_PUBLIC_DOMAIN}}/auth/strava/callback
STRAVA_WEBHOOK_TOKEN=unconfigured
POLAR_CLIENT_ID=unconfigured
POLAR_CLIENT_SECRET=unconfigured
POLAR_REDIRECT_URI=https://${{RAILWAY_PUBLIC_DOMAIN}}/auth/polar/callback
POLAR_WEBHOOK_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}/webhooks/polar
POLAR_WEBHOOK_SECRET_KEY=unconfigured
BREVO_API_KEY=unconfigured
BREVO_FROM_EMAIL=noreply@example.com
OPENAI_API_KEY=unconfigured
GOOGLE_GENERATIVE_AI_API_KEY=unconfigured

# StripeService is instantiated eagerly and throws without a key, so a
# placeholder is required even though the schema marks it optional.
STRIPE_SECRET_KEY=sk_test_unconfigured

# --- Feature flags ------------------------------------------------------
ENABLE_ACTIVITY_IMPORT=true
ENABLE_ACTIVITY_PROCESSING=true
ENABLE_TRAINING_LOAD_ESTIMATION=true

# --- Optional integrations ----------------------------------------------
# Leave these variables UNSET. Setting them to an empty string fails the
# Zod URL validation at boot:
#   GARMIN_* SUUNTO_* FIREBASE_FUNCTIONS_URL BETTER_STACK_DSN
#   STRIPE_PRICE_IDS STRIPE_WEBHOOK_SECRET

# --- web service --------------------------------------------------------
# PORT=80
# VITE_API_BASE_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}
