# =============================================================================
# OpenAthlete Web - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# Note: Vite uses the VITE_ prefix for environment variables
# Documentation: https://github.com/tristanblt/openathlete/blob/main/CONTRIBUTING.md
# =============================================================================

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------

# Base URL of the API server
# Development: http://localhost:3000
# Production: https://api.openathlete.org

# If not set, defaults to:
#   - http://localhost:3000 (web)
#   - https://api.openathlete.org (Capacitor/native)
VITE_API_BASE_URL=http://localhost:3000

# Showcase website URL
VITE_WEBSITE_URL=http://localhost:3003

# Public URL of this web app.
# Used by the iOS payment dialog to send the user to the web version.
# If not set, defaults to https://app.openathlete.org
VITE_WEB_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Payments (optional)
# -----------------------------------------------------------------------------

# Set to 'true' to hide all billing/subscription UI.
# Recommended when the API runs without STRIPE_SECRET_KEY, and forced on
# anyway for iOS builds (Apple requires in-app purchases).
# Anything other than the exact string 'true' leaves payments enabled.
VITE_DISABLE_PAYMENTS=false

# -----------------------------------------------------------------------------
# Firebase Authentication (optional)
# -----------------------------------------------------------------------------

# Required only if you enable social sign-in (Google/Apple) in the web build.
# All four must be set together — if any is missing, sign-in throws
# "Firebase web config is missing (VITE_FIREBASE_*)". Leave all four unset to
# run with email/password authentication only.
# Get them from: Firebase console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# Product analytics (PostHog, optional)
# -----------------------------------------------------------------------------

# PostHog project token and host. Leave unset to run without analytics.
# Get them from: PostHog > Settings > Project
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# -----------------------------------------------------------------------------
# Browser error monitoring (Better Stack / Sentry SDK, optional)
# -----------------------------------------------------------------------------

# DSN the browser ships uncaught errors and traces to. Leave unset (or empty)
# to disable browser error reporting entirely — no Sentry.init, no network
# traffic, nothing leaves the user's browser.
# This MUST point at an account the deployment's owner controls: every DSN is a
# write endpoint for someone's error inbox, so pointing it at a third party's
# project silently ships your users' errors to them.
# Note: VITE_* variables are baked in at BUILD time, so this has to be set for
# the `pnpm web build` / Docker build, not just at runtime.
# Get it from: Better Stack > Telemetry > Sources (or your Sentry project)
VITE_BETTER_STACK_DSN=