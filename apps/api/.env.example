# =============================================================================
# OpenAthlete API - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Never commit .env to version control!
#
# WHAT IS ACTUALLY REQUIRED
# -------------------------
# The API refuses to boot without these five:
#     ENV  NODE_ENV  DATABASE_URL  JWT_SECRET_KEY  HASH_PEPPER
#
# Everything else is optional. Leave a third-party credential out entirely and
# the feature it powers simply stays dark: the app boots normally, and the
# affected endpoint reports a clear error only when it is actually called.
#
# Do NOT fill unused integrations with placeholder values. A placeholder makes
# the app believe the integration is configured, turning a clean
# "not configured" response into a confusing failure from the third party.
#
# Documentation: https://github.com/tristanblt/openathlete/blob/main/CONTRIBUTING.md
# =============================================================================

# =============================================================================
# REQUIRED
# =============================================================================

# -----------------------------------------------------------------------------
# Application Core
# -----------------------------------------------------------------------------

# Application environment: 'development' | 'staging' | 'production'
ENV=development

# Node environment: 'development' | 'production' | 'test'
NODE_ENV=development

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------

# JWT secret key for signing tokens (must be at least 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# Pepper for password hashing (additional security layer)
# Generate with: openssl rand -base64 16
HASH_PEPPER=your-hash-pepper-change-this-in-production

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/openathlete?schema=public

# =============================================================================
# OPTIONAL — infrastructure & app wiring
# =============================================================================

# Server port (default: 3000)
PORT=3000

# Base URL of the application (used for generating links in emails, etc.)
# Example: http://localhost:5173 (dev) or https://app.openathlete.org (prod)
APP_URL=http://localhost:5173

# CORS allowed origins (comma-separated)
# For development, include: http://localhost:5173,capacitor://localhost
# For production, include your production domains
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost

# Redis connection URL (used for queues, caching, Socket.IO adapter)
# Format: redis://[:password@]host[:port][/database]
# Defaults to redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------

# Enable activity import from providers (true/false)
ENABLE_ACTIVITY_IMPORT=true

# Enable activity processing (GPX parsing, metrics calculation, etc.)
ENABLE_ACTIVITY_PROCESSING=true

# =============================================================================
# OPTIONAL — third-party integrations
# =============================================================================
# Every block below can be omitted entirely. Delete or comment out the whole
# block for any integration you are not using.

# -----------------------------------------------------------------------------
# Email (Brevo)
# -----------------------------------------------------------------------------
# Without BREVO_API_KEY the app logs a warning and skips every outgoing email.
# Signup confirmations, invitations and password-reset links are not delivered.
# Get a key from: https://app.brevo.com/settings/keys/api

# BREVO_API_KEY=your-brevo-api-key

# Sender address (must be verified in Brevo).
# Defaults to noreply@openathlete.org when unset.
# BREVO_FROM_EMAIL=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# Intervals.icu Integration
# -----------------------------------------------------------------------------
# Intervals.icu has no OAuth flow for personal accounts: it authenticates with a
# static API key from Developer Settings at https://intervals.icu/settings
#
# Both variables are optional and only matter for single-user deployments that
# would rather configure the credential on the server than paste it into the
# settings UI. Leave them unset and Intervals.icu is still connectable — the
# connect dialog just becomes the only way in.
#
# When set, the key is used only if the connect request supplies none; a key
# entered in the UI always wins. It is validated against the Intervals.icu
# athlete endpoint at connect time, so a typo fails immediately and loudly.

# INTERVALS_ICU_API_KEY=your-intervals-icu-api-key

# Athlete ID that goes with the key above, e.g. i123456 (note the leading "i").
# Optional even when the key is set: the server resolves it from the API.
# INTERVALS_ICU_ATHLETE_ID=i123456

# -----------------------------------------------------------------------------
# Firebase
# -----------------------------------------------------------------------------
# Only needed for push notifications and Firebase ID token verification.

# Format: https://your-region-your-project.cloudfunctions.net
# FIREBASE_FUNCTIONS_URL=https://your-region-your-project.cloudfunctions.net

# Firebase Admin service account JSON, as a single-line string
# FIREBASE_SERVICE_ACCOUNT_JSON='{}'

# -----------------------------------------------------------------------------
# Monitoring & Error Tracking
# -----------------------------------------------------------------------------

# Better Stack DSN. Leave unset to run without error reporting.
# BETTER_STACK_DSN=https://dsn@zone.betterstackdata.com/id
