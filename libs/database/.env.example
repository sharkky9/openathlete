DATABASE_URL="postgresql://username:password@localhost:5432/openathlete?schema=public"

# Optional. The demo-data seed (scripts/seed-demo-month.ts, wired into the Prisma
# seed hook) only runs when ENV is "development" or "test"; otherwise it skips.
# Set this to have `prisma migrate dev`/`reset` (or `db:seed:demo-month`) seed
# the demo month locally. Leave unset in shared/hosted databases.
# ENV=development
